{
  "dataset_root": "${GID15_DATASET_ROOT}",
  "clustered_dataset_root": "../data_specs/gid15_clustered_dataset",
  "cluster_mapping_file": "manifests/sample_cluster_mapping.relative.csv",
  "label_list": "../data_specs/gid15_dataset/labels.txt",
  "class_names": [
    "background",
    "industrial_land",
    "urban_residential",
    "rural_residential",
    "traffic_land",
    "paddy_field",
    "irrigated_land",
    "dry_cropland",
    "garden_plot",
    "arbor_woodland",
    "shrub_land",
    "natural_grassland",
    "artificial_grassland",
    "river",
    "lake",
    "pond"
  ],
  "num_classes": 16,
  "routing": {
    "selected_k": 4,
    "num_heads": 1,
    "cluster_names": [
      "shared_head"
    ],
    "sample_path_source": "input",
    "cluster_id_handling": "ignore",
    "routing_source": "release/data_specs/gid15_clustered_dataset/manifests/sample_cluster_mapping.relative.csv"
  },
  "model": {
    "name": "ClusterRoutedUNet",
    "in_channels": 3,
    "use_deconv": false,
    "align_corners": false
  },
  "pretrained": {
    "weights": "CITYSCAPES",
    "weights_path": null,
    "source": "PaddleRS UNet CITYSCAPES pretrained weights"
  },
  "training": {
    "epochs": 40,
    "train_batch_size": 4,
    "eval_batch_size": 1,
    "learning_rate": 0.005,
    "lr_scheduler": "poly",
    "lr_decay_power": 0.9,
    "weight_decay": 0.00004,
    "momentum": 0.9,
    "crop_size": 512,
    "save_interval_epochs": 1,
    "eval_interval": 1,
    "log_interval_steps": 20,
    "resume_checkpoint": null,
    "seed": 20260406
  },
  "augmentation": {
    "random_horizontal_flip": true,
    "random_vertical_flip": true,
    "enable_distort": true,
    "distort": {
      "brightness_range": 0.15,
      "contrast_range": 0.15,
      "saturation_range": 0.15,
      "brightness_prob": 0.6,
      "contrast_prob": 0.6,
      "saturation_prob": 0.6
    },
    "enable_blur": false,
    "blur_prob": 0.05
  },
  "normalization": {
    "mean": [
      0.5,
      0.5,
      0.5
    ],
    "std": [
      0.5,
      0.5,
      0.5
    ]
  },
  "loss": {
    "use_mixed_loss": true,
    "ce_lovasz_coef": [
      0.8,
      0.2
    ],
    "ignore_index": 255
  },
  "evaluation": {
    "selection_split": "val",
    "selection_metric": "miou",
    "final_eval_split": "test",
    "compute_confusion_matrix": true,
    "save_per_class_metrics_csv": true,
    "export_prediction_samples": true,
    "prediction_sample_count": 12
  },
  "save_dir": "../runs/unet_singlehead"
}
