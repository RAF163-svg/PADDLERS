{
  "dataset_root": "${GID15_DATASET_ROOT}/gid15_dataset",
  "clustered_dataset_root": "${GID15_DATASET_ROOT}/gid15_clustered_dataset",
  "cluster_mapping_file": "manifests/sample_cluster_mapping.csv",
  "label_list": "labels.txt",
  "class_names": [
    "background",
    "industrial_land",
    "urban_residential",
    "rural_residential",
    "traffic_land",
    "paddy_field",
    "irrigated_land",
    "dry_cropland",
    "garden_plot",
    "arbor_woodland",
    "shrub_land",
    "natural_grassland",
    "artificial_grassland",
    "river",
    "lake",
    "pond"
  ],
  "num_classes": 16,
  "routing": {
    "selected_k": 4,
    "num_heads": 4,
    "cluster_names": [
      "cluster_0",
      "cluster_1",
      "cluster_2",
      "cluster_3"
    ],
    "sample_path_source": "input",
    "routing_source": "sample_cluster_mapping.csv"
  },
  "model": {
    "name": "ClusterRoutedDeepLabV3",
    "backbone": "ResNet50_vd",
    "backbone_pretrained": true,
    "backbone_indices": [
      3
    ],
    "aspp_ratios": [
      1,
      6,
      12,
      18
    ],
    "aspp_out_channels": 256,
    "trunk_channels": 256,
    "align_corners": false,
    "dropout_prob": 0.1
  },
  "training": {
    "epochs": 40,
    "train_batch_size": 8,
    "eval_batch_size": 2,
    "learning_rate": 0.005,
    "lr_scheduler": "poly",
    "lr_decay_power": 0.9,
    "weight_decay": 0.0001,
    "momentum": 0.9,
    "crop_size": 640,
    "num_workers": 4,
    "save_interval_epochs": 1,
    "log_interval_steps": 20,
    "resume_checkpoint": null,
    "seed": 20260403
  },
  "augmentation": {
    "random_horizontal_flip": true,
    "random_vertical_flip": true,
    "enable_distort": true,
    "distort": {
      "brightness_range": 0.2,
      "contrast_range": 0.2,
      "saturation_range": 0.2,
      "brightness_prob": 0.7,
      "contrast_prob": 0.7,
      "saturation_prob": 0.7,
      "hue_prob": 1.0
    },
    "enable_blur": false
  },
  "normalization": {
    "mean": [
      0.5,
      0.5,
      0.5
    ],
    "std": [
      0.5,
      0.5,
      0.5
    ]
  },
  "evaluation": {
    "selection_split": "val",
    "final_eval_split": "test",
    "compute_confusion_matrix": true,
    "save_per_class_metrics_csv": true,
    "export_prediction_samples": true,
    "prediction_sample_count": 12
  },
  "save_dir": "output"
}
