  "num_classes": 16,
  "model": {
    "name": "FarSeg",
    "in_channels": 3,
    "backbone": "resnet50",
    "backbone_pretrained": true,
    "fpn_out_channels": 256,
    "fsr_out_channels": 256,
    "scale_aware_proj": true,
    "decoder_out_channels": 128
  },
  "pretrained": {
    "backbone_source": "paddle.vision.models.resnet ImageNet",
    "model_weights_path": null
  },
  "training": {
    "epochs": 40,
    "train_batch_size": 8,
    "eval_batch_size": 1,
    "learning_rate": 0.005,
    "lr_decay_power": 0.9,
    "crop_size": 512,
    "save_interval_epochs": 1,
    "log_interval_steps": 20,
    "early_stop": true,
    "early_stop_patience": 10,
    "use_mixed_loss": true,
    "num_workers": "auto",
    "resume_checkpoint": null,
    "precision": "fp32",
    "amp_level": "O1",
    "seed": 20260329
  },
  "augmentation": {
    "random_horizontal_flip": true,
    "random_vertical_flip": true,
    "enable_distort": true,
    "distort": {
      "brightness_range": 0.2,
      "contrast_range": 0.2,
      "saturation_range": 0.2,
      "brightness_prob": 0.7,
      "contrast_prob": 0.7,
      "saturation_prob": 0.7,
      "hue_prob": 1.0
    },
    "enable_blur": true,
    "blur_prob": 0.1
