    "${GID15_DATASET_ROOT}/gid-15"
  ],
  "train_file_list": "lists/train.txt",
  "val_file_list": "lists/val.txt",
  "test_file_list": "lists/test.txt",
  "label_list": "labels.txt",
  "class_names": [
    "background",
    "industrial_land",
    "urban_residential",
    "rural_residential",
    "traffic_land",
    "paddy_field",
    "irrigated_land",
    "dry_cropland",
    "garden_plot",
    "arbor_woodland",
    "shrub_land",
    "natural_grassland",
    "artificial_grassland",
    "river",
    "lake",
    "pond"
