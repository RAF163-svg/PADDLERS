    "target_class_index": 12,
    "target_class_name": "artificial_grassland",
    "oversample_ratio": 3
  },
  "evaluation": {
    "selection_split": "val",
    "final_eval_split": "test",
    "export_predictions": true,
    "export_visualizations": true,
    "compute_confusion_matrix": true,
    "save_per_class_metrics_csv": true
  },
  "save_dir": "output"
